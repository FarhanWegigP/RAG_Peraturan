# Salin jadi `.env` lalu isi kuncinya.
#
# Penyedia LLM: satu blok per penyedia. Nama di belakang garis bawah itu BEBAS
# -- yang dipakai ChatRequest.penjawab / MODEL_PENJAWAB. Tanpa akhiran = lokal.

# --- lokal (LM Studio)
LLM_BASE=http://192.168.18.185:1234/v1
LLM_MODEL=google/gemma-4-12b-qat
LLM_KEY=

# --- Groq
LLM_BASE_Groq=https://api.groq.com/openai/v1
LLM_MODEL_Groq=openai/gpt-oss-120b
LLM_KEY_Groq=

# --- OpenAI
LLM_BASE_OpenAI=https://api.openai.com/v1
LLM_MODEL_OpenAI=gpt-5.6-luna
LLM_KEY_OpenAI=

# Penyedia bawaan tiap tahap. "" = lokal.
MODEL_PLANNER=
MODEL_PENJAWAB=OpenAI
TIMEOUT_LLM=420

# --- retrieval
VARIAN=c                       # varian indeks unit di Qdrant
PROBE=50                       # calon per kunci sebelum RRF
K=10                           # cadangan kalau planner tidak menyebut cakupan
RERANKER=BAAI/bge-reranker-v2-m3
PERANGKAT=cuda                 # cpu kalau tidak ada GPU (jauh lebih lambat)
QDRANT_URL=                    # kosong -> ikut embed.QDRANT

# Tempat embed.py tinggal. JANGAN menyalin embed.py ke sini -- satu salinan saja.
AKAR_PROYEK=d:/DDTC/Magang

# --- server
CORS_ASAL=*
